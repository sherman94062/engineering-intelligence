{
  "name": "engineering-intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "forwardPorts": [3002, 4000, 8080, 8811],
  "portsAttributes": {
    "3002": { "label": "Grafana — DORA dashboard", "onAutoForward": "openPreview" },
    "4000": { "label": "DevLake config UI" },
    "8080": { "label": "DevLake REST API" },
    "8811": { "label": "MCP server (HTTP)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  },
  "waitFor": "postCreateCommand",
  "remoteUser": "vscode"
}
