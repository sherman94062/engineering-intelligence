# ==============================================================
# devlake-mcp environment template.
# Copy to devlake-config/env and fill in. Never commit the real file.
# ==============================================================

# ----- DevLake admin (config-ui basic auth) -----
DEVLAKE_ADMIN_USER=admin
DEVLAKE_ADMIN_PASS=change-me

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=devlake
MYSQL_PASSWORD=change-me-devlake
MYSQL_DATABASE=lake

# ----- GitHub connection -----
# PAT scopes required by DevLake's GraphQL collectors:
#   repo          — read repo metadata, commits, PRs
#   read:user     — read reviewer/author email fields (required, not optional)
#   read:org      — read org membership if ingesting org-owned repos
GITHUB_TOKEN=ghp_replace_me
GITHUB_ORG_OR_USER=sherman94062

# Comma-separated list of repos to ingest under GITHUB_ORG_OR_USER
GITHUB_REPOS=argus,mcp-security-stack,databricks-mcp-server,analytics-agent,agent-benchmarks,dbt-semantic-layer-agent,nl-to-sql-agent

# ----- MCP server -----
DB_URL=mysql+pymysql://devlake:change-me-devlake@localhost:3306/lake
MCP_PORT=8811
MCP_HOST=0.0.0.0

# ----- Grafana -----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ----- DevLake internals -----
DEVLAKE_ENCRYPTION_SECRET=replace-with-32-char-random-string
TZ=UTC
